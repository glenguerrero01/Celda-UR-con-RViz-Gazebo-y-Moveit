<?xml version="1.0"?>
<!-- Macro de celda reutilizable: RViz y Gazebo comparten las mismas mallas -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macros y gripper -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/gripper.xacro"/>

  <!-- ====== Materiales ====== -->
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="red_ue"><color rgba="1 0.19 0.16 1"/></material>
  <material name="grey_light"><color rgba="0.8 0.8 0.8 1.0"/></material>
  <material name="grey_dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue_hint"><color rgba="0.2 0.4 0.8 1.0"/></material>

  <!-- Textura del logo (panel de la pared) -->
  <material name="logo_tex">
    <texture filename="package://robot_description/meshes/UE_Logo_Positive_RGB.png"/>
  </material>

  <!-- ====== Propiedades (mesa/taza) ====== -->
  <xacro:property name="pedestal_dim_x" value="2.50"/>
  <xacro:property name="pedestal_dim_y" value="0.80"/>
  <xacro:property name="pedestal_dim_z" value="0.90"/>

  <xacro:property name="mount_radius"     value="0.15"/>
  <xacro:property name="mount_thickness"  value="0.04"/>

  <!-- Taza (malla local) 
  <xacro:property name="mug_mesh_path"
    value="package://robot_description/meshes/cc_by/Threshold_Porcelain_Coffee_Mug_All_Over_Bead_White/meshes/model.obj"/>
  <xacro:property name="mug_scale_x" value="1.0"/>
  <xacro:property name="mug_scale_y" value="1.0"/>
  <xacro:property name="mug_scale_z" value="1.0"/>
  <xacro:property name="mug_h" value="0.30"/>
  <xacro:property name="mug_r" value="0.05"/>

  <xacro:property name="mug_pos_x" value="0.6"/>
  <xacro:property name="mug_pos_y" value="0.20"/>
  <xacro:property name="mug_pos_z" value="${pedestal_dim_z}"/>

  -->

  <!-- Macro principal -->
  <xacro:macro name="robot_cell" params="
    parent
    *origin
    ur_type
    joint_limits_parameters_file
    kinematics_parameters_file
    physical_parameters_file
    visual_parameters_file">

    <!-- 1) Suelo -->
    <link name="floor">
      <visual>
        <geometry><box size="6.0 6.0 0.02"/></geometry>
        <material name="white"/>
        <origin xyz="0 0 -0.01"/>
      </visual>
      <collision>
        <geometry><box size="6.0 6.0 0.02"/></geometry>
        <origin xyz="0 0 -0.01"/>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="0 0 -0.01"/>
      </inertial>
    </link>

    <joint name="base_to_floor" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child  link="floor"/>
    </joint>

    <!-- 2) Mesa blanca -->
    <link name="pedestal">
      <visual>
        <geometry><box size="${pedestal_dim_x} ${pedestal_dim_y} ${pedestal_dim_z}"/></geometry>
        <material name="white"/>
        <origin xyz="0 0 ${0.5 * pedestal_dim_z}"/>
      </visual>
      <collision>
        <geometry><box size="${pedestal_dim_x} ${pedestal_dim_y} ${pedestal_dim_z}"/></geometry>
        <origin xyz="0 0 ${0.5 * pedestal_dim_z}"/>
      </collision>
      <inertial>
        <mass value="40.0"/>
        <inertia ixx="2.0" iyy="2.0" izz="2.0" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="0 0 ${0.5 * pedestal_dim_z}"/>
      </inertial>
    </link>

    <joint name="floor_to_pedestal" type="fixed">
      <parent link="floor"/>
      <child  link="pedestal"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- 3) Plato de montaje -->
    <link name="robot_mount">
      <visual>
        <geometry><cylinder radius="${mount_radius}" length="${mount_thickness}"/></geometry>
        <material name="red_ue"/>
        <origin xyz="0 0 0"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${mount_radius}" length="${mount_thickness}"/></geometry>
        <origin xyz="0 0 0"/>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="0 0 0"/>
      </inertial>
    </link>

    <joint name="pedestal_to_robot_mount" type="fixed">
      <parent link="pedestal"/>
      <child  link="robot_mount"/>
      <origin xyz="0 0 ${pedestal_dim_z + 0.5 * mount_thickness}"/>
    </joint>

    <!-- 4) Paredes -->
    <link name="factory_wall_back">
      <visual>
        <geometry><box size="6.0 0.1 3.0"/></geometry>
        <material name="white"/>
        <origin xyz="0 -2.95 1.5"/>
      </visual>
      <collision>
        <geometry><box size="6.0 0.1 3.0"/></geometry>
        <origin xyz="0 -2.95 1.5"/>
      </collision>
    </link>
    <joint name="floor_to_wall_back" type="fixed">
      <parent link="floor"/><child link="factory_wall_back"/>
      <origin xyz="0 0 0"/>
    </joint>

    <link name="factory_wall_left">
      <visual>
        <geometry><box size="0.1 6.0 3.0"/></geometry>
        <material name="white"/>
        <origin xyz="-2.95 0 1.5"/>
      </visual>
      <collision>
        <geometry><box size="0.1 6.0 3.0"/></geometry>
        <origin xyz="-2.95 0 1.5"/>
      </collision>
    </link>
    <joint name="floor_to_wall_left" type="fixed">
      <parent link="floor"/><child link="factory_wall_left"/>
      <origin xyz="0 0 0"/>
    </joint>

    <link name="factory_wall_right">
      <visual>
        <geometry><box size="0.1 6.0 3.0"/></geometry>
        <material name="white"/>
        <origin xyz="2.95 0 1.5"/>
      </visual>
      <collision>
        <geometry><box size="0.1 6.0 3.0"/></geometry>
        <origin xyz="2.95 0 1.5"/>
      </collision>
    </link>
    <joint name="floor_to_wall_right" type="fixed">
      <parent link="floor"/><child link="factory_wall_right"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- 5) Panel con logo -->
    <link name="logo_panel">
      <visual>
        <geometry><box size="4.5 0.002 1.24"/></geometry>
        <material name="logo_tex"/>
        <origin xyz="0 -2.899 2.25"/>
      </visual>
      <collision>
        <geometry><box size="4.5 0.002 1.24"/></geometry>
        <origin xyz="0 -2.899 2.25"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="0 -2.899 2.25"/>
      </inertial>
    </link>
    <joint name="wall_back_to_logo_panel" type="fixed">
      <parent link="factory_wall_back"/>
      <child  link="logo_panel"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- 6) Pallet con cajas (malla local) -->
    <xacro:property name="pallet_scale_x" value="1.0"/>
    <xacro:property name="pallet_scale_y" value="1.0"/>
    <xacro:property name="pallet_scale_z" value="1.0"/>
    <link name="euro_pallet_stack">
      <visual>
        <geometry>
          <mesh
            filename="package://robot_description/meshes/cc_by/euro_pallet_w_stacked_boxes/meshes/euro_pallet_w_stacked_boxes.dae"
            scale="${pallet_scale_x} ${pallet_scale_y} ${pallet_scale_z}"/>
        </geometry>
        <origin xyz="-1.2 -1.2 0.0" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><box size="1.20 0.80 1.20"/></geometry>
        <origin xyz="-1.2 -1.2 0.60" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="50.0"/>
        <inertia ixx="5" iyy="5" izz="5" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="-1.2 -1.2 0.60"/>
      </inertial>
    </link>
    <joint name="floor_to_euro_pallet_stack" type="fixed">
      <parent link="floor"/>
      <child  link="euro_pallet_stack"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- 7) Taza 
    <link name="mug">
      <visual>
        <geometry>
          <mesh filename="${mug_mesh_path}"
                scale="${mug_scale_x } ${mug_scale_y } ${mug_scale_z}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${mug_r}" length="${mug_h}"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/>
        <origin xyz="0 0 0"/>
      </inertial>
    </link>
    <joint name="pedestal_to_mug" type="fixed">
      <parent link="pedestal"/>
      <child  link="mug"/>
      <origin xyz="${mug_pos_x} ${mug_pos_y} ${mug_pos_z}" rpy="0 0 0"/>
    </joint>
    -->
    <!-- 8) Robot UR + gripper -->
    <xacro:ur_robot
      name="${ur_type}"
      tf_prefix="${ur_type}_"
      parent="robot_mount"
      joint_limits_parameters_file="${joint_limits_parameters_file}"
      kinematics_parameters_file="${kinematics_parameters_file}"
      physical_parameters_file="${physical_parameters_file}"
      visual_parameters_file="${visual_parameters_file}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>

    <xacro:gripper_minimal parent_link="${ur_type}_tool0" prefix="g_"/>

  </xacro:macro>
</robot>
