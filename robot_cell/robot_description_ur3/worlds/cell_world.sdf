<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="cell_world">
    <!-- Luz direccional tipo "sol" (sustituye a model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <gravity>0 0 -9.81</gravity>

    <!-- Pallet (malla local package://) -->
    <model name="euro_pallet_stack">
      <static>true</static>
      <pose>-1.2 -1.2 0 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <mesh>
              <uri>file:///root/ros2_ws/install/robot_description/share/robot_description/meshes/cc_by/euro_pallet_w_stacked_boxes/meshes/euro_pallet_w_stacked_boxes.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="col">
          <geometry><box><size>1.2 0.8 1.2</size></box></geometry>
          <pose>0 0 0.6 0 0 0</pose>
        </collision>
      </link>
    </model>

    <!-- Taza -->
    <model name="mug">
      <static>true</static>
      <pose>1.20 0.20 0.90 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <mesh>
              <uri>file:///root/ros2_ws/install/robot_description/share/robot_description/meshes/cc_by/Threshold_Porcelain_Coffee_Mug_All_Over_Bead_White/meshes/model.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="col">
          <geometry><cylinder><radius>0.05</radius><length>0.30</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- El robot UR se crea desde /robot_description con ros_gz_sim create -->
  </world>
</sdf>
