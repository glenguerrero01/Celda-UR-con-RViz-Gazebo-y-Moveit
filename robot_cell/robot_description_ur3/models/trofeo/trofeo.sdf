<?xml version="1.0"?>
<sdf version="1.9">
  <model name="trofeo">
    <pose>0 0 0 0 0 0</pose>

    <link name="trofeo_link">
      <inertial>
        <!-- Trofeo mediano: ~250 g, centro de masas hacia la base por estabilidad -->
        <mass>0.25</mass>
        <inertia>
          <ixx>3.5e-4</ixx>
          <iyy>3.5e-4</iyy>
          <izz>2.5e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0.08 0 0 0</pose>
      </inertial>

      <!-- Colision: cilindro simplificado para que DART (Gazebo) lo soporte
           y el gripper lo pueda atrapar de forma estable.
           Ajusta radius/length a la silueta real de tu trofeo. -->
      <collision name="trofeo_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Visual: la malla del trofeo. Ajusta scale segun las unidades del STL.
           Si el STL viene en milimetros, scale 0.001 0.001 0.001.
           Si viene en metros, scale 1 1 1. -->
      <visual name="trofeo_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description/meshes/trofeo/trofeo.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
