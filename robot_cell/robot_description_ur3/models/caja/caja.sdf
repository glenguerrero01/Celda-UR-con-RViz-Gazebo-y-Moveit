<?xml version="1.0"?>
<sdf version="1.9">
  <model name="caja">
    <pose>0 0 0 0 0 0</pose>

    <link name="caja_link">
      <inertial>
        <!-- Caja de 5x5x5 cm, masa 150 g -->
        <mass>0.15</mass>
        <inertia>
          <ixx>6.25e-5</ixx>
          <iyy>6.25e-5</iyy>
          <izz>6.25e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0.025 0 0 0</pose>
      </inertial>

      <!-- Colision: box exacta de 5x5x5 cm -->
      <collision name="caja_collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Visual: STL escalado x2 (si el STL original era de 25 mm).
           Si tu STL ya es de 50 mm, cambia a scale 0.001 0.001 0.001 -->
      <visual name="caja_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description_ur3/meshes/caja/caja.stl</uri>
            <scale>0.002 0.002 0.002</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
