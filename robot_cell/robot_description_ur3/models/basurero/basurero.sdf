<?xml version="1.0"?>
<sdf version="1.9">
  <model name="basurero">
    <pose>0 0 0 0 0 0</pose>

    <static>true</static>

    <link name="basurero_link">
      <inertial>
        <!-- Basurero: ~1 kg, centro de masas en la base por estabilidad.
             Si es estatico (no se va a mover) los valores no importan
             realmente, pero los dejamos razonables. -->
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0e-2</ixx>
          <iyy>1.0e-2</iyy>
          <izz>1.0e-2</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0.10 0 0 0</pose>
      </inertial>

      <!-- Colision: cilindro generico, ajusta radius/length a tu basurero real -->
      <collision name="basurero_collision">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Visual: malla del basurero. Ajusta scale segun unidades del STL.
           Si tu STL viene en mm: 0.001 0.001 0.001.
           Si viene en metros: 1 1 1. -->
      <visual name="basurero_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://robot_description_ur3/meshes/basurero/basurero.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
